{
  "name": "pi-web-simple",
  "version": "0.13.0",
  "description": "Local web UI for the pi coding agent — one directory per workspace, in the shell of deepseek-harness",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web-simple": "bin/pi-web-simple.js"
  },
  "files": [
    "bin",
    "extensions",
    "server/build",
    "web/dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "docs/README.zh-CN.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.js"
    ],
    "image": "https://raw.githubusercontent.com/woxihejinghao/pi-web/main/docs/images/overview-dark.png"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "coding-agent",
    "web",
    "ui",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woxihejinghao/pi-web.git"
  },
  "homepage": "https://github.com/woxihejinghao/pi-web#readme",
  "bugs": {
    "url": "https://github.com/woxihejinghao/pi-web/issues"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "node bin/pi-web-simple.js",
    "dev:desktop": "pnpm build && pnpm --filter pi-web-simple-desktop run dev",
    "package:desktop": "pnpm --filter pi-web-simple-desktop run package",
    "icons:desktop": "pnpm --filter pi-web-simple-desktop run icons",
    "typecheck": "pnpm -r run typecheck && pnpm exec tsc -p tsconfig.extensions.json",
    "test": "pnpm -r run test",
    "test:ask-user": "pnpm --filter @pi-web-simple/server exec tsx src/testing/ask-user-e2e.mts",
    "test:plan-mode": "pnpm --filter @pi-web-simple/server exec tsx src/testing/plan-mode-e2e.mts",
    "test:file-refs": "pnpm --filter @pi-web-simple/server exec tsx ../bench/verify-file-refs.ts",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test && node scripts/verify-dist.mjs"
  },
  "//peerDependencies": "宿主提供给扩展的包，pi 只在自己的模块映射里提供它们：见 pi 的 docs/packages.md。放进 dependencies 会让安装副本绕过那层映射、产生重复的类和注册表，pi 启动时会就此报警。",
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "//devDependencies": "上面那些包在仓库里同样被非扩展代码用到（bench/scenario-a-processes.mjs 直接跑 pi 的 RPC，desktop 的打包脚本要找到 pi 的 cli.js），所以本地开发仍要一份真依赖；发布出去的那份由宿主提供。typescript 只为了能对 extensions/ 跑一遍类型检查（它们不归属任何子包）。",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "typescript": "^5.7.2"
  }
}
